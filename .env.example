# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toastup?schema=public

# ---- Telegram Bot ----
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- URLs ----
WEB_APP_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# ---- Dev only ----
# Allow logging in without a real Telegram initData signature (browser testing).
ALLOW_DEV_AUTH=true
PORT=4000
