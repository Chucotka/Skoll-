{
  "name": "toastup",
  "version": "0.1.0",
  "private": true,
  "description": "ToastUp — a social Telegram Mini App for online hangouts, virtual toasts and friendly evening rooms.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web dev:bot",
    "dev:server": "npm run dev --workspace @toastup/server",
    "dev:web": "npm run dev --workspace @toastup/web",
    "dev:bot": "npm run dev --workspace @toastup/bot",
    "build": "npm run build --workspace @toastup/shared && npm run build --workspace @toastup/server && npm run build --workspace @toastup/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @toastup/server",
    "prisma:migrate": "npm run prisma:migrate --workspace @toastup/server",
    "prisma:seed": "npm run prisma:seed --workspace @toastup/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
